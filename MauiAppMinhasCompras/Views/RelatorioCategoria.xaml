<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.RelatorioCategoriaPage"
             Title="Relatório por Categoria">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Atualizar" Clicked="ToolbarItem_Atualizar_Clicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Spacing="10" Padding="10">
        <Label Text="Total gasto por categoria" FontAttributes="Bold" />

        <Frame Padding="0" Margin="0" VerticalOptions="FillAndExpand">
            <ListView x:Name="lst_relatorio">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid ColumnDefinitions="*, 120">
                                <Label Grid.Column="0" Text="{Binding Categoria}" Padding="10,5" />
                                <Label Grid.Column="1" Text="{Binding Total, StringFormat='{}{0:C}'}" HorizontalTextAlignment="End" Padding="10,5" />
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Frame>

    </VerticalStackLayout>
</ContentPage>
