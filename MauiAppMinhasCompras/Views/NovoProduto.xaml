<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked"/>
    </ContentPage.ToolbarItems>
    
    <VerticalStackLayout Spacing="10" Padding="10">
        
        <Label Text="Descrição do produto:" />
        <Entry x:Name="txt_descricao" Placeholder="Digite a descrição do produto" />
        
        <Label Text="Quantidade:" />
        <Entry x:Name="txt_quantidade" Placeholder="Digite a quantidade" Keyboard="Numeric" />
        
        <Label Text="Preço Unitário:" />
        <!-- Usar Keyboard="Text" para permitir inserir vírgula ou ponto em todas as plataformas -->
        <Entry x:Name="txt_preco" Placeholder="Digite o preço unitário" Keyboard="Text" TextChanged="txt_preco_TextChanged" />

        <Label Text="Categoria:" />
        <Picker x:Name="picker_categoria" />
        
    </VerticalStackLayout>
</ContentPage>