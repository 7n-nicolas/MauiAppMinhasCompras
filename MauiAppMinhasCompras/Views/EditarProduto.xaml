<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.EditarProduto"
             Title="{Binding Descricao}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Spacing="10" Padding="10">

        <Label Text="Descrição do produto:" />
        <Entry x:Name="txt_descricao" Text="{Binding Descricao}" />

        <Label Text="Quantidade:" />
        <Entry x:Name="txt_quantidade" Keyboard="Text" />

        <Label Text="Preço Unitário:" />
        <!-- Usar Keyboard="Text" para permitir inserir vírgula ou ponto em todas as plataformas -->
        <Entry x:Name="txt_preco" Keyboard="Text" TextChanged="txt_preco_TextChanged" />

        <Label Text="Categoria:" />
        <Picker x:Name="picker_categoria" />

    </VerticalStackLayout>
</ContentPage>